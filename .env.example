# Smart Krishi Environment Configuration
SECRET_KEY=smart-krishi-secret-key-super-secure-change-in-prod
FLASK_ENV=development
FLASK_APP=app.py
DATABASE=database/smart_krishi.db

# Weather API (Default uses Open-Meteo free API - no key needed)
# Optional: Set OpenWeatherMap or IMD API key if desired
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# AI Crop Disease Detection Provider (hybrid / local / gemini)
AI_MODEL_PROVIDER=hybrid
GEMINI_API_KEY=
